{
  "name": "neon-arcade",
  "version": "2.1.0",
  "description": "Cyberpunk decentralized Web3 arcade & prediction suite built for BOT Chain Testnet.",
  "scripts": {
    "dev": "next dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "next build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "next start",
    "lint": "next lint",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network botchainMainnet",
    "verify:mainnet": "node scripts/verify_cmd.js",
    "deploy:testnet": "hardhat run scripts/deploy.js --network botchainTestnet",
    "verify:testnet": "node scripts/verify_cmd.js",
    "flatten": "hardhat flatten contracts/NeonArcadeScore.sol > NeonArcadeScore_flattened.sol",
    "test": "hardhat test"
  },
  "keywords": [
    "neon-oracle",
    "neon-arcade",
    "web3",
    "botchain",
    "bot-chain",
    "prediction-game",
    "solidity",
    "nextjs",
    "dapp"
  ],
  "author": "Neon Arcade Architect",
  "license": "MIT",
  "dependencies": {
    "@metamask/connect-evm": "^0.1.0",
    "@noble/curves": "1.4.0",
    "@noble/hashes": "1.4.0",
    "@reown/appkit": "^1.1.0",
    "@reown/appkit-adapter-wagmi": "^1.1.0",
    "@scure/bip39": "1.3.0",
    "@tanstack/react-query": "^5.50.0",
    "@wagmi/core": "^2.21.2",
    "dotenv": "^10.0.0",
    "ethers": "^5.7.2",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0",
    "wagmi": "^2.14.9",
    "web3": "^1.6.1"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.0.0",
    "@nomiclabs/hardhat-etherscan": "^3.1.8",
    "@nomiclabs/hardhat-waffle": "^2.0.0",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "chai": "^4.3.4",
    "ethereum-waffle": "^3.0.0",
    "hardhat": "^2.0.0",
    "mocha": "^8.3.2",
    "typescript": "^5.5.2"
  }
}
